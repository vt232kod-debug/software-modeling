@startuml
' =====================================================================
' ЧЕРНЕТКА, ЗГЕНЕРОВАНА ШІ (перший прохід, ДО ручного виправлення).
' Файл збережено НАВМИСНО з усіма хибами — він потрібен лише для
' розділу «Критичний аналіз ШІ-чернетки» звіту і НЕ є результатом
' лабораторної роботи. Хиби, заради яких чернетку збережено:
'   1) псевдостан історії намальовано, але події призупинення немає;
'   2) стан «Призупинена» недосяжний — жодного входу в нього;
'   3) два переходи без події зовсім;
'   4) дві гілки з події `оцінитиЯкість()` без охоронних умов;
'   5) «Показ вправи» і «Обчислення інтервалу» — дії, а не стани;
'   6) подія `оцінитиЯкість(якість)` не відповідає жодному методу ЛР2;
'   7) кінцевого псевдостану немає зовсім.
' Камінський Олексій Дмитрович, група ВТ-23-2
' =====================================================================

skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 14
skinparam shadowing false
skinparam ArrowFontSize 12
skinparam state {
  BackgroundColor #FDF2F2
  BorderColor #B03A2E
  ArrowColor #B03A2E
  FontStyle bold
  AttributeFontSize 12
  StartColor #B03A2E
  EndColor #B03A2E
}

state "Нова" as Нова
state "Показ вправи" as ПоказВправи
state "Обчислення інтервалу" as ОбчисленняІнтервалу
state "Вчиться" as Вчиться {
  state "Крок 1" as Крок1
  state "Крок 2" as Крок2
  [*] --> Крок1
  Крок1 --> Крок2 : оцінитиЯкість(якість)
  state H <<history>>
}
state "Повторення" as Повторення
state "Перевчається" as Перевчається
state "Призупинена" as Призупинена

[*] --> Нова
Нова --> ПоказВправи : відкритиСесію()
ПоказВправи --> ОбчисленняІнтервалу : оцінитиЯкість(якість)
ОбчисленняІнтервалу --> Вчиться
Вчиться --> Повторення
Повторення --> Повторення : оцінитиЯкість(якість)
Повторення --> Перевчається : оцінитиЯкість(якість)
Перевчається --> Повторення : оцінитиЯкість(якість)
@enduml
