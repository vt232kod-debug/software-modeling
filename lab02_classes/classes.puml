@startuml
' Лабораторна робота №2. Діаграма класів предметної області
' Предметна область: «Півот» — вебсервіс і браузерне розширення
' для вивчення іноземної мови на основі власного контенту користувача
' Камінський Олексій Дмитрович, група ВТ-23-2

skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 15
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam ArrowFontSize 13
skinparam nodesep 22
skinparam ranksep 55
skinparam class {
  BackgroundColor #FEFEFE
  BorderColor #33668E
  ArrowColor #33668E
}
skinparam package {
  BackgroundColor #F7FAFC
  BorderColor #9AB3C6
  FontStyle bold
}
skinparam interface {
  BackgroundColor #FFF8EC
  BorderColor #B07A28
}
skinparam note {
  BackgroundColor #FFFDF2
  BorderColor #C9B47A
}

' =====================================================================
' ПАКЕТ 1. Акаунт і доступ
' =====================================================================
package "Акаунт і доступ" {

  class Користувач {
    - id: UUID
    + пошта: Email
    + імʼя: String
    - поштаПідтверджена: Boolean
    - створений: DateTime
    + тариф(): ТарифEnum
    + профільВідомих(мова: КодМови): Set<ВідомеСлово>
    + вивантажитиДані(): Архів
  }

  class НалаштуванняКористувача {
    - id: UUID
    + {field} ключ: String(64)
    + значення: JSON
    - оновлено: DateTime
    + встановити(ключ: String, значення: JSON): void
    + секретний(): Boolean
  }

  class Підписка {
    - id: UUID
    + провайдер: String
    + зовнішнійId: String
    + статус: СтатусEnum
    + кінецьПеріоду: DateTime
    + активна(): Boolean
    + пробна(): Boolean
    + стеля(вид: ВидВитратиEnum): Int
  }

  class ЛічильникВикористання {
    + день: Date {id}
    + вид: ВидВитратиEnum {id}
    + кількість: Int
    + списати(n: Int): void
    + залишок(тариф: ТарифEnum): Int
    + скиданняЧерез(): Duration
  }
}

' =====================================================================
' ПАКЕТ 2. Матеріали користувача
' =====================================================================
package "Матеріали користувача" {

  abstract class Матеріал {
    # id: UUID
    + назва: String
    + моваКонтенту: КодМови
    + зрозумілість: Real
    - картаЧастот: Map<String,Int>
    - кількістьТокенів: Int
    + перерахуватиЗрозумілість(профіль: Set<ВідомеСлово>): Real
    + позиціяЧитання(): Progress
    + {abstract} джерелоТексту(): Iterable<Реплика>
  }

  class Відео {
    + платформа: ПлатформаEnum
    + зовнішнійId: String
    + тривалістьМс: Long
    + останняПозиціяМс: Long
    + джерелоТексту(): Iterable<Реплика>
    + посиланняНаМомент(мс: Long): URL
  }

  class Документ {
    + формат: ФорматEnum
    - вміст: Text
    - початкиСторінок: Int[]
    + відпечаток: SHA256
    + поточнаСторінка: Int
    + одиницяСторінки: ОдиницяEnum
    + джерелоТексту(): Iterable<Реплика>
    + сторінка(n: Int): Text
    + змінитиМову(код: КодМови): void
  }
}

' =====================================================================
' ПАКЕТ 3. Словник, профіль лексики та прогрес
' =====================================================================
package "Словник і прогрес" {

  class ЗбереженеСлово {
    - id: UUID
    + слово: String
    + переклад: String
    + контекст: String
    + моваДжерела: КодМови
    + моваЦілі: КодМови
    - {field} вектор: Vector(768)
    + озвучити(акцент: АкцентEnum): Audio
    + схожіЗаЗмістом(n: Int): List<ЗбереженеСлово>
    + прикріпитиДоТеми(тема: ТемаСловника): void
  }

  class ТемаСловника {
    - id: UUID
    + назва: String
    + піктограма: String
    + службова: Boolean
    - відкрита: DateTime
    + прогрес(): Real
    + нові(): Int
    + перейменувати(назва: String): void
  }

  class ВідомеСлово {
    - id: UUID
    + слово: String
    + мова: КодМови
    + походження: ПоходженняEnum
    - додано: DateTime
    + скасувати(): void
    + виведене(): Boolean
  }

  class СтанПовторення {
    - id: UUID
    + наступне: DateTime
    + стабільність: Real
    + складність: Real
    + повторень: Int
    + стан: СтанEnum
    + застосуватиВідповідь(результат: РезультатВправи): void
    + прострочене(): Boolean
    + наступнийІнтервал(): Duration
  }

  class ОцінкаРівня {
    - id: UUID
    + мова: КодМови
    + обсягСловника: Int
    + cefr: String
    - пройдено: DateTime
    + похибка(): Int
    + виведеніВідомі(корпус: ЧастотнийКорпус): List<String>
    + динаміка(): Delta
  }
}

' =====================================================================
' ПАКЕТ 4. Спільні довідники без власника
' =====================================================================
package "Спільні довідники без власника" {

  class Транскрипт {
    - id: UUID
    + платформа: ПлатформаEnum
    + відеоId: String
    + мова: КодМови
    + реплики: Реплика[]
    + кількістьРеплік: Int
    + постачальник: String
    + реплікаНаЧас(мс: Long): Реплика
    + відпечаток(): SHA256
    + перекласти(цільоваМова: КодМови): Транскрипт
  }

  class РоботаРозпізнавання {
    - id: UUID
    + платформа: ПлатформаEnum
    + відеоId: String
    + стан: СтанРоботиEnum
    - етап: String
    + спроб: Int
    + тривалістьЗвукуМс: Long
    + просунути(стан: СтанРоботиEnum): void
    + завершена(): Boolean
    + причинаНеудачі(): String
  }

  class КешПерекладу {
    - ключ: SHA256
    + моваДжерела: КодМови
    + моваЦілі: КодМови
    + переклади: String[]
    + кількістьРядків: Int
    + постачальник: String
    + знайти(ключ: SHA256): String[]
    + частковий(): Boolean
  }

  class КешПояснень {
    - ключ: SHA256
    + вид: ВидРозборуEnum
    + запит: String
    + відповідь: JSON
    + постачальник: String
    - востаннєВжито: DateTime
    + знайти(ключ: SHA256): JSON
    + застарілий(): Boolean
  }

  class ПереказДоріжки {
    - ключ: SHA256
    + назва: String
    + переказ: JSON
    + кількістьРядків: Int
    + рядки(): List<String>
    + збігаєтьсяЗ(т: Транскрипт): Boolean
  }

  class СловниковаСтаття {
    - id: UUID
    + лема: String
    + параМов: String
    + важливість: Real
    + значення: Значення[]
    + головніПереклади(n: Int): List<String>
    + дляБудьЯкоїФорми(форма: String): Boolean
  }
}

' =====================================================================
' ПАКЕТ 5. Точки підстановки: інтерфейси та їхні реалізації
' =====================================================================
package "Підстановка джерел і парсерів" {

  interface ДжерелоСубтитрів {
    + знайтиПлеєр(): Плеєр
    + спостерігатиНавігацію(обробник: Обробник): void
    + сховатиРодніСубтитри(прапор: Boolean): void
    + отриматиДоріжку(): Транскрипт
    + побудуватиДжерелоСлова(позиціяМс: Long): ДжерелоСлова
    + розкладкаПанелі(): Розкладка
  }

  class ДжерелоСубтитрівYouTube {
    - відеоId: String
    - адресаTimedtext: URL
    - автогенерована: Boolean
    - елементПлеєра: Плеєр
    + отриматиДоріжку(): Транскрипт
    + сховатиРодніСубтитри(прапор: Boolean): void
    .. решта операцій інтерфейсу ..
  }

  class ФабрикаДжерелСубтитрів {
    - реєстр: Map<ПлатформаEnum,Тип>
    - типоваПлатформа: ПлатформаEnum
    - активне: ДжерелоСубтитрів
    + створити(платформа: ПлатформаEnum): ДжерелоСубтитрів
    + зареєструвати(платформа: ПлатформаEnum, тип: Тип): void
  }

  interface ПарсерДокумента {
    + підтримує(формат: ФорматEnum): Boolean
    + розібрати(файл: Файл): Документ
    + розбитиНаСторінки(текст: Text): Int[]
    + визначитиМову(текст: Text): КодМови
  }

  class ПарсерPDF {
    - максимальнийРозмірМБ: Int
    - маєТекстовийШар: Boolean
    - межіСторінокОригіналу: Int[]
    + розібрати(файл: Файл): Документ
    + розбитиНаСторінки(текст: Text): Int[]
    .. решта операцій інтерфейсу ..
  }
}

' =====================================================================
' УЗАГАЛЬНЕННЯ (generalization)
' =====================================================================
Матеріал <|-- Відео
Матеріал <|-- Документ

' =====================================================================
' РЕАЛІЗАЦІЯ ІНТЕРФЕЙСУ (realization)
' =====================================================================
ДжерелоСубтитрів <|.. ДжерелоСубтитрівYouTube
ПарсерДокумента <|.. ПарсерPDF

' =====================================================================
' КОМПОЗИЦІЯ (composition) — спільний життєвий цикл з акаунтом
' =====================================================================
Користувач "0..1" *-- "1..*" НалаштуванняКористувача : налаштування
Користувач "1" *-- "0..1" Підписка : тариф
Користувач "1" *-- "0..*" ЛічильникВикористання : денні витрати
Користувач "0..1" *-- "0..*" Матеріал : історія матеріалів
Користувач "0..1" *-- "0..*" ЗбереженеСлово : особистий словник
Користувач "1" *-- "0..*" ТемаСловника : теми словника
Користувач "0..1" *-- "0..*" ВідомеСлово : профіль лексики
Користувач "0..1" *-- "0..*" ОцінкаРівня : історія тестів
ЗбереженеСлово "1" *-- "0..1" СтанПовторення : розписання

note bottom of Користувач
  **0..1, а не 1, у пʼяти композиціях:**
  рядок, накопичений до першого входу,
  ще не має власника. Нуль — перехідний
  стан до привʼязки, а не другий власник.
  Де власник обовʼязковий (підписка,
  лічильники, теми) — кратність 1.
  Докладно: Розділ 6, вступ.
end note

' =====================================================================
' АГРЕГАЦІЯ (aggregation) — частина не належить цьому цілому як композит
' =====================================================================
Матеріал "1" o-- "0..*" ЗбереженеСлово : джерело слова
note on link
  **Агрегація, а не композиція — компроміс.**
  Кратність 1: картки слова без матеріалу
  не буває. Частина цього цілого НЕ переживає:
  видалення матеріалу забирає й слова,
  й розписання. Ромб порожній лише тому, що
  композит у частини один — Користувач.
  Розділ 7, рядок 10.
end note

ТемаСловника "0..1" o-- "0..*" ЗбереженеСлово : згруповані слова

' =====================================================================
' АСОЦІАЦІЯ З КРАТНІСТЮ (association)
' =====================================================================
Відео "0..*" -- "0..1" Транскрипт : доріжка реплік >
Відео "0..*" -- "0..1" РоботаРозпізнавання : замовлене розпізнавання >
Транскрипт "1" -- "0..*" КешПерекладу : переклад доріжки >
Транскрипт "1" -- "0..1" ПереказДоріжки : переказ >
ЗбереженеСлово "0..*" -- "0..1" СловниковаСтаття : стаття довідника >
ЗбереженеСлово "0..*" -- "0..1" КешПояснень : пояснення в контексті >
ОцінкаРівня "0..1" -- "0..*" ВідомеСлово : поповнює профіль >

' =====================================================================
' ЗАЛЕЖНІСТЬ (dependency)
' =====================================================================
Відео ..> ДжерелоСубтитрів : читає доріжку через >
ФабрикаДжерелСубтитрів ..> ДжерелоСубтитрів : <<create>>
ПарсерДокумента ..> Документ : <<create>>

' =====================================================================
' ПРИМІТКИ ДО КЛЮЧОВИХ РІШЕНЬ МОДЕЛІ
' =====================================================================
note top of "Спільні довідники без власника"
  Усі шість класів **навмисно без звʼязку
  з Користувачем**: ключ — вміст або
  ідентифікатор ролика, тому «хто дивився»
  з них не дізнатися. Спільними є саме
  розпізнавання й переклад доріжки.
  Докладно: Розділ 6.1.
end note

note right of Документ
  Стаття за посиланням — це Документ
  з форматом «стаття-html» (UC12), тому
  нащадків рівно два; окремий клас для
  вебсторінки — поза межами роботи
  (розділ «Мета»). Звʼязок «документ —
  рядок історії» виражений узагальненням,
  тому асоціації «Документ — Матеріал» немає.
end note

note bottom of ЛічильникВикористання
  Технічного id немає: рядок
  ідентифікується парою «день + вид»
  у межах власника — обидва атрибути
  позначено модифікатором {id}.
end note


@enduml
