@startuml
' ЛР2. Частковий вид 3: матеріали, спільні транскрипти й точки підстановки
' (узагальнення, реалізація інтерфейсу, асоціація, залежність)
' «Півот». Камінський Олексій Дмитрович, ВТ-23-2

skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 16
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam ArrowFontSize 14
skinparam nodesep 22
skinparam ranksep 65
skinparam class {
  BackgroundColor #FEFEFE
  BorderColor #33668E
  ArrowColor #33668E
}
skinparam interface {
  BackgroundColor #FFF8EC
  BorderColor #B07A28
}
skinparam note {
  BackgroundColor #FFFDF2
  BorderColor #C9B47A
}

abstract class Матеріал {
  # id: UUID
  + назва: String
  + моваКонтенту: КодМови
  + зрозумілість: Real
  - картаЧастот: Map<String,Int>
  - кількістьТокенів: Int
  + перерахуватиЗрозумілість(профіль: Set<ВідомеСлово>): Real
  + позиціяЧитання(): Progress
  + {abstract} джерелоТексту(): Iterable<Реплика>
}

class Відео {
  + платформа: ПлатформаEnum
  + зовнішнійId: String
  + тривалістьМс: Long
  + останняПозиціяМс: Long
  + джерелоТексту(): Iterable<Реплика>
  + посиланняНаМомент(мс: Long): URL
}

class Документ {
  + формат: ФорматEnum
  - вміст: Text
  - початкиСторінок: Int[]
  + відпечаток: SHA256
  + поточнаСторінка: Int
  + одиницяСторінки: ОдиницяEnum
  + джерелоТексту(): Iterable<Реплика>
  + сторінка(n: Int): Text
  + змінитиМову(код: КодМови): void
}

class Транскрипт {
  - id: UUID
  + платформа: ПлатформаEnum
  + відеоId: String
  + мова: КодМови
  + реплики: Реплика[]
  + кількістьРеплік: Int
  + постачальник: String
  + реплікаНаЧас(мс: Long): Реплика
  + відпечаток(): SHA256
  + перекласти(цільоваМова: КодМови): Транскрипт
}

class ПереказДоріжки {
  - ключ: SHA256
  + назва: String
  + переказ: JSON
  + кількістьРядків: Int
  + рядки(): List<String>
  + збігаєтьсяЗ(т: Транскрипт): Boolean
}

class РоботаРозпізнавання {
  - id: UUID
  + платформа: ПлатформаEnum
  + відеоId: String
  + стан: СтанРоботиEnum
  - етап: String
  + спроб: Int
  + тривалістьЗвукуМс: Long
  + просунути(стан: СтанРоботиEnum): void
  + завершена(): Boolean
  + причинаНеудачі(): String
}

class КешПерекладу {
  - ключ: SHA256
  + моваДжерела: КодМови
  + моваЦілі: КодМови
  + переклади: String[]
  + кількістьРядків: Int
  + постачальник: String
  + знайти(ключ: SHA256): String[]
  + частковий(): Boolean
}

interface ДжерелоСубтитрів {
  + знайтиПлеєр(): Плеєр
  + спостерігатиНавігацію(обробник: Обробник): void
  + сховатиРодніСубтитри(прапор: Boolean): void
  + отриматиДоріжку(): Транскрипт
  + побудуватиДжерелоСлова(позиціяМс: Long): ДжерелоСлова
  + розкладкаПанелі(): Розкладка
}

class ДжерелоСубтитрівYouTube {
  - відеоId: String
  - адресаTimedtext: URL
  - автогенерована: Boolean
  - елементПлеєра: Плеєр
  + знайтиПлеєр(): Плеєр
  + спостерігатиНавігацію(обробник: Обробник): void
  + сховатиРодніСубтитри(прапор: Boolean): void
  + отриматиДоріжку(): Транскрипт
  + побудуватиДжерелоСлова(позиціяМс: Long): ДжерелоСлова
  + розкладкаПанелі(): Розкладка
}

class ДжерелоСубтитрівВласнийФайл #E4EBF1 {
  - формат: ФорматСубтитрівEnum
  - завантаженийФайл: Файл
  - зсувТаймінгуМс: Long
  + отриматиДоріжку(): Транскрипт
  + розкладкаПанелі(): Розкладка
}

class ДжерелоСубтитрівРозпізнане #E4EBF1 {
  - станРоботи: СтанРоботиEnum
  - постачальникШІ: String
  - вартістьХвилини: Real
  + отриматиДоріжку(): Транскрипт
  + станРозпізнавання(): СтанРоботиEnum
}

class ФабрикаДжерелСубтитрів {
  - реєстр: Map<ПлатформаEnum,Тип>
  - типоваПлатформа: ПлатформаEnum
  - активне: ДжерелоСубтитрів
  + створити(платформа: ПлатформаEnum): ДжерелоСубтитрів
  + зареєструвати(платформа: ПлатформаEnum, тип: Тип): void
}

interface ПарсерДокумента {
  + підтримує(формат: ФорматEnum): Boolean
  + розібрати(файл: Файл): Документ
  + розбитиНаСторінки(текст: Text): Int[]
  + визначитиМову(текст: Text): КодМови
}

class ПарсерPDF {
  - максимальнийРозмірМБ: Int
  - маєТекстовийШар: Boolean
  - межіСторінокОригіналу: Int[]
  + підтримує(формат: ФорматEnum): Boolean
  + розібрати(файл: Файл): Документ
  + розбитиНаСторінки(текст: Text): Int[]
  + визначитиМову(текст: Text): КодМови
}

class ПарсерEPUB #E4EBF1 {
  - зміст: Розділ[]
  - кодування: String
  - кількістьРозділів: Int
  + розібрати(файл: Файл): Документ
  + розбитиНаСторінки(текст: Text): Int[]
}

class ПарсерПростогоТексту #E4EBF1 {
  - одиницяСторінки: ОдиницяEnum
  - розмірСторінки: Int
  - джерело: ДжерелоВставкиEnum
  + розібрати(файл: Файл): Документ
  + визначитиМову(текст: Text): КодМови
}

' --- узагальнення ---
Матеріал <|-- Відео
Матеріал <|-- Документ

' --- реалізація інтерфейсу ---
ДжерелоСубтитрів <|.. ДжерелоСубтитрівYouTube
ДжерелоСубтитрів <|.. ДжерелоСубтитрівВласнийФайл
ДжерелоСубтитрів <|.. ДжерелоСубтитрівРозпізнане
ПарсерДокумента <|.. ПарсерPDF
ПарсерДокумента <|.. ПарсерEPUB
ПарсерДокумента <|.. ПарсерПростогоТексту

' --- асоціація з кратністю ---
Відео "0..*" -- "0..1" Транскрипт : доріжка реплік >
Відео "0..*" -- "0..1" РоботаРозпізнавання : замовлене розпізнавання >
Транскрипт "1" -- "0..*" КешПерекладу : переклад доріжки >
Транскрипт "1" -- "0..1" ПереказДоріжки : переказ >

' --- залежність ---
Відео ..> ДжерелоСубтитрів : читає доріжку через >
ФабрикаДжерелСубтитрів ..> ДжерелоСубтитрів : <<create>>
ПарсерДокумента ..> Документ : <<create>>

note bottom of ДжерелоСубтитрівРозпізнане
  **Сірим показано чотири класи, яких на повній
  діаграмі (рисунок 1) немає.** Вони існують у коді,
  але лежать поза межами роботи й наведені тут лише
  як доказ підстановності контракту. Білі класи цього
  виду — точна підмножина рисунка 1. Адаптери інших
  платформ (Netflix, Udemy, Crunchyroll, TED)
  підключаються до тієї самої фабрики й на моделі
  присутні лише як точка підстановки.
end note

note right of Транскрипт
  Транскрипт спільний і без власника: ключ —
  платформа + ідентифікатор відео. Сервер зберігає
  спільно доріжку, зроблену розпізнаванням; доріжку,
  віддану самою платформою, розширення читає в межах
  сторінки й на сервері не кешує. Кратність 0..* з боку
  Відео означає, що запис історії другого глядача того
  самого ролика посилається на вже наявну доріжку й не
  коштує ні грошей, ні квоти — це справджується для
  розпізнавання та для перекладу доріжки.
end note
@enduml
